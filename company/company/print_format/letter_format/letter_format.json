 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>{{ doc.subject or \"HR Document\" }} - {{ doc.employee_name or \"\" }}</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\r\n</head>\r\n<body style=\"margin:0; padding:0; font-family:'Montserrat', sans-serif; background:#f4f6f8; color:#1a1a1a; -webkit-print-color-adjust:exact; print-color-adjust:exact;\">\r\n\r\n    <table class=\"letter-page\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:210mm; min-height:297mm; margin:0 auto; background:#ffffff; box-sizing:border-box; border-collapse:collapse; table-layout:fixed;\">\r\n        <tr>\r\n            <td style=\"padding:0;\">\r\n\r\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; table-layout:fixed;\">\r\n                    <tr>\r\n                        <td style=\"width:70%; height:0.3px; background:#2cb5e8; font-size:0; line-height:0;\">&nbsp;</td>\r\n                        <td style=\"width:30%; height:0.3px; background:#2d3436; font-size:0; line-height:0;\">&nbsp;</td>\r\n                    </tr>\r\n                </table>\r\n\r\n                <!-- Header Section -->\r\n                <table class=\"header-section\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; table-layout:fixed;\">\r\n                    <tr>\r\n                        <td style=\"padding:30px 45px 10px 45px; vertical-align:top; text-align:left; width:35%; box-sizing:border-box;\">\r\n                            <!-- Company Logo -->\r\n                            <img src=\"https://erp.innoblitz.in/assets/Innoblitz%20Logo%20Full.png\" alt=\"Innoblitz Technologies Logo\" style=\"height:150px; width:auto; display:block;\">\r\n                        </td>\r\n                        <td style=\"padding:30px 45px 10px 45px; vertical-align:top; text-align:right; width:65%; box-sizing:border-box; word-wrap:break-word; overflow-wrap:break-word;\">\r\n                            <!-- Contact Information -->\r\n                            <table align=\"right\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; font-size:13.5px; color:#333333; font-weight:500; margin-left:auto; margin-right:0; max-width:100%;\">\r\n                                <tr>\r\n                                    <td style=\"text-align:right;\">\r\n                                        Tel:&nbsp;+91-9500359896\r\n                                    </td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td style=\"text-align:right;\">\r\n                                        Tel:&nbsp;+91-9551413321\r\n                                    </td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td style=\"text-align:right;\">\r\n                                        Email:&nbsp;info@innoblitz.global\r\n                                    </td>\r\n                                </tr>\r\n                                <tr>\r\n                                    <td style=\"text-align:right;\">\r\n                                        Web:&nbsp;www.innoblitz.global\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n\r\n                <!-- Letter Body Container -->\r\n                <table class=\"letter-body\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\r\n                    <tr>\r\n                        <td style=\"padding:20px 45px 30px 45px;\">\r\n\r\n                            <!-- Date -->\r\n                            <div style=\"text-align:right; font-size:14px; font-weight:600; color:#111111; margin-bottom:30px;\">\r\n                                Date: {{ frappe.utils.formatdate(doc.generated_on or frappe.utils.nowdate(), \"dd/MM/yyyy\") }}\r\n                            </div>\r\n\r\n                            <!-- Subject / Title -->\r\n                            <div class=\"letter-title\" style=\"text-align:center; font-size:16px; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#000000; text-decoration:underline; text-underline-offset:6px; margin-bottom:40px;\">\r\n                                {{ doc.rendered_subject or doc.subject or \" \" }}\r\n                            </div>\r\n\r\n                            <!-- Dynamic Document Content Generator Output -->\r\n                            <div class=\"letter-content\" style=\"font-size:12px; line-height:2.1; color:#1a1a1a; text-align:justify; margin-bottom:40px;\">\r\n                                {{ doc.rendered_content or doc.template_content }}\r\n                            </div>\r\n\r\n                            <!-- Signatures -->\r\n                            <table class=\"signatures-section\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; margin-top:50px;\">\r\n                                <tr>\r\n                                    <td style=\"width:250px; text-align:left; vertical-align:bottom;\">\r\n                                        <div style=\"font-size:14px; font-weight:700; color:#000000; margin-bottom:12px;\">For Authorized Signatory,</div>\r\n                                    </td>\r\n                                    <td style=\"text-align:right; vertical-align:bottom;\">\r\n                                        <div style=\"font-size:13.5px; font-weight:700; color:#111111; border-top:1px solid #111111; padding-top:8px; display:inline-block; min-width:200px;\">Candidate&rsquo;s Signature</div>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n\r\n                <!-- Footer Banner Section -->\r\n                <table class=\"letter-footer\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:collapse; margin-top:20px;\">\r\n                    <tr>\r\n                        <td style=\"text-align:center; font-size:11.5px; font-weight:700; color:#2b323a; padding:10px 20px; background:#ffffff; border-top:1px solid #e0e0e0; line-height:1.6;\">\r\n                            Web Applications | Mobile Apps | Customized Softwares | ERP &amp; CRM | UI &amp; UX | Branding<br>\r\n                            Dynamic Websites | Business Portals | E-Commerce Solutions | Cloud Servers | Support &amp; Maintenance\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"background:#2cb5e8; color:#ffffff; text-align:center; padding:13px 20px; font-size:13px; font-weight:700; letter-spacing:0.3px;\">\r\n                            14/18, 1st Floor, Govindan Street, Ayyavoo Colony, Aminjikarai, Chennai - 600 029.\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</body>\r\n</html>",
