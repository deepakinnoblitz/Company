 "css": "@media print {\r\n    html, body {\r\n        margin: 0;\r\n        padding: 0;\r\n        background: none !important;\r\n        -webkit-print-color-adjust: exact;\r\n        print-color-adjust: exact;\r\n        overflow: visible;\r\n    }\r\n    @page {\r\n        size: A4;\r\n        margin: 0;\r\n    }\r\n    .letter-page {\r\n        width: 100%;\r\n        max-width: 210mm;\r\n        min-height: 297mm;\r\n        box-sizing: border-box;\r\n        margin: -10 !important;        /* was margin:0 auto without !important \u2014 inline margin:20px auto was winning */\r\n        padding: 0 !important;\r\n        border: none !important;\r\n        background: none !important;\r\n        page-break-before: avoid;\r\n        page-break-after: avoid;\r\n        page-break-inside: avoid;\r\n    }\r\n    /* Remove display:block !important for these \u2014 they're tables now, not flex/divs.\r\n       Just keep them from splitting across pages: */\r\n    .header-section,\r\n    .letter-body,\r\n    .letter-title,\r\n    .letter-content,\r\n    .signatures-section,\r\n    .letter-footer {\r\n        page-break-inside: avoid !important;\r\n        break-inside: avoid-page !important;\r\n        width: 100%;\r\n    }\r\n    table, tr, td, th, tbody, thead, tfoot {\r\n        border-collapse: collapse !important;\r\n        page-break-inside: avoid !important;\r\n        break-inside: avoid !important;\r\n    }\r\n    body, td, th, span {\r\n        color: #000 !important;\r\n        line-height: 1.3 !important;\r\n    }\r\n    .watermark {\r\n        position: fixed;\r\n        top: 50%;\r\n        left: 50%;\r\n        transform: translate(-50%, -50%);\r\n        opacity: 0.2;\r\n        z-index: 0;\r\n        font-size: 120px;\r\n        color: #2d3436;\r\n        font-weight: 700;\r\n        text-transform: uppercase;\r\n        white-space: nowrap;\r\n        pointer-events: none;\r\n        user-select: none;\r\n    }\r\n    .content, .letter-body, .letter-footer {\r\n        position: relative;\r\n        z-index: 1;\r\n    }\r\n}",
